rules_version = '2';

// Правила доступу до бази порталу. Їх перевіряє сервер Firebase,
// тож без схваленої заявки до чату й оголошень не дістатися навіть в обхід сайту.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Адміністратор: власник порталу (перший, хто натиснув «Стати адміністратором»)
    // або той, кого додали в колекцію admins.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Молодший модератор: схвалений учасник, якого призначив власник.
    function isMod() {
      return approved() && exists(/databases/$(database)/documents/mods/$(request.auth.uid));
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return hasProfile() && me().status == 'approved'; }
    // Клас учня; для батьків — клас дитини. Вчителі бачать усі класи.
    function myClass() { return me().role == 'parent' ? me().childClass : me().cls; }
    function canUseClass(c) {
      return isAdmin() || (approved() && (me().role == 'teacher' || myClass() == c));
    }
    function shortText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'role', 'cls', 'subject', 'child', 'childClass',
                               'contact', 'note', 'status', 'createdAt', 'reviewedAt'])
        && shortText(d.name, 2, 60)
        && d.role in ['student', 'teacher', 'parent']
        && d.status in ['pending', 'approved', 'rejected']
        && (d.role != 'student' || (d.cls is int && d.cls >= 1 && d.cls <= 9))
        && (d.role != 'teacher' || shortText(d.subject, 2, 60))
        && (d.role != 'parent' || (shortText(d.child, 2, 60)
                                   && d.childClass is int && d.childClass >= 1 && d.childClass <= 9))
        && (!('contact' in d) || shortText(d.contact, 0, 80))
        && (!('note' in d) || shortText(d.note, 0, 300));
    }

    // Власника можна призначити лише один раз — поки документа ще немає.
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Додаткових адміністраторів додає власник у консолі Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isOwner();
    }

    // Молодших модераторів призначає й знімає лише власник.
    match /mods/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isMod());
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Список учасників (ім'я, роль, клас), щоб запрошувати в чати.
    // Читають схвалені учасники, пише лише адміністратор.
    match /directory/{uid} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'cls'])
        && shortText(request.resource.data.name, 2, 60)
        && (request.resource.data.cls == null
            || (request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 9));
      allow delete: if isAdmin();
    }

    // Заявки = профілі користувачів.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Нова заявка: лише від свого імені й лише зі статусом «на розгляді».
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data);

      // Адміністратор схвалює, відхиляє або виправляє заявку.
      allow update: if isAdmin() && validProfile(request.resource.data);

      // Користувач може виправити й подати заявку знову, поки її не схвалили.
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.status != 'approved'
        && validProfile(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data);

      allow delete: if isAdmin();
    }

    // Коли людина востаннє заходила. Бачить лише адміністратор,
    // записати можна лише свій час і лише поточний.
    match /presence/{uid} {
      allow read: if isAdmin() || isMod();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
    }

    // Чат класу: classes/<номер класу>/messages/<id>
    match /classes/{cls}/messages/{msg} {
      allow read: if canUseClass(int(cls)) || isMod();
      allow create: if canUseClass(int(cls)) && hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.role == me().role
        && shortText(request.resource.data.text, 1, 500)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Окремі чати. Працюють лише після схвалення адміністратором;
    // нових учасників теж додає адміністратор (зі списку invited).
    match /groups/{gid} {
      allow read: if isAdmin() || isMod() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'invited', 'status', 'createdAt'])
        && shortText(request.resource.data.name, 2, 40)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invited is list
        && request.resource.data.invited.size() >= 1 && request.resource.data.invited.size() <= 40
        && !(request.auth.uid in request.resource.data.invited)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // Адміністратор схвалює чат або запрошення.
      allow update: if isAdmin();
      // Автор чату запрошує ще людей — вони чекають схвалення адміністратора.
      allow update: if approved() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
        && request.resource.data.invited is list && request.resource.data.invited.size() <= 40;
      // Учасник може вийти з чату.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      allow delete: if isAdmin();

      match /messages/{mid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        function inGroup() { return approved() && grp().status == 'approved' && request.auth.uid in grp().members; }
        allow read: if isAdmin() || inGroup();
        allow create: if inGroup()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == me().name
          && request.resource.data.role == me().role
          && shortText(request.resource.data.text, 1, 500)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Оголошення: cls = 0 — для всієї школи, 1–9 — для класу.
    match /announcements/{id} {
      allow read: if isAdmin() || approved();
      allow create: if (isAdmin() || approved()) && hasProfile()
        && request.resource.data.keys().hasOnly(['cls', 'title', 'text', 'uid', 'name', 'role', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.role == me().role
        && request.resource.data.cls is int
        && request.resource.data.cls >= 0 && request.resource.data.cls <= 9
        && (isAdmin() || me().role == 'teacher' || request.resource.data.cls == myClass())
        && shortText(request.resource.data.title, 2, 80)
        && shortText(request.resource.data.text, 1, 1000)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
