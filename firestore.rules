rules_version = '2';

// Правила доступу до бази порталу. Їх перевіряє сервер Firebase,
// тож без схваленої заявки до чату й оголошень не дістатися навіть в обхід сайту.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Адміністратор: власник порталу (перший, хто натиснув «Стати адміністратором»)
    // або той, кого додали в колекцію admins.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/meta/owner)
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // Молодший модератор: схвалений учасник, якого призначив власник.
    function isMod() {
      return approved() && exists(/databases/$(database)/documents/mods/$(request.auth.uid));
    }
    function isStaff() { return isAdmin() || isMod(); }
    // Мут: людина тимчасово не може писати.
    function muted() {
      return exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
        && get(/databases/$(database)/documents/mutes/$(request.auth.uid)).data.until > request.time;
    }
    // Адміністраторів і модераторів не можна замутити.
    function protectedUser(uid) {
      return exists(/databases/$(database)/documents/mods/$(uid))
        || exists(/databases/$(database)/documents/admins/$(uid))
        || (exists(/databases/$(database)/documents/meta/owner)
            && get(/databases/$(database)/documents/meta/owner).data.uid == uid);
    }
    // Нове повідомлення: текст або опитування (opts — від 2 до 6 варіантів).
    function validMessage(d) {
      return d.keys().hasOnly(['uid', 'name', 'role', 'text', 'createdAt', 'opts', 'reply', 'media'])
        && (!('media' in d) || (d.media is map && d.media.keys().hasOnly(['kind', 'id', 'dur'])
                                && d.media.kind in ['img', 'audio'] && shortText(d.media.id, 1, 40)))
        && (!('reply' in d) || (d.reply is map && d.reply.keys().hasOnly(['id', 'name', 'text'])
                                && shortText(d.reply.id, 1, 40) && shortText(d.reply.name, 0, 60)
                                && shortText(d.reply.text, 0, 100)))
        && d.uid == request.auth.uid
        && d.name == me().name
        && d.role == me().role
        && shortText(d.text, 1, 500)
        && (!('opts' in d) || (d.opts is list && d.opts.size() >= 2 && d.opts.size() <= 6))
        && d.createdAt == request.time;
    }
    // Фото чи голосове: окремий документ поруч із повідомленнями (до ~400 КБ).
    function validMedia(d) {
      return d.keys().hasOnly(['uid', 'kind', 'data', 'dur', 'at'])
        && d.uid == request.auth.uid
        && ((d.kind == 'img' && d.data is string && d.data.size() <= 420000 && d.data[0:11] == 'data:image/')
            || (d.kind == 'audio' && d.data is string && d.data.size() <= 420000 && d.data[0:11] == 'data:audio/'))
        && (!('dur' in d) || (d.dur is number && d.dur >= 0 && d.dur <= 120))
        && d.at == request.time;
    }
    // Автор може виправити текст свого повідомлення (не опитування).
    function editOk() {
      let d = request.resource.data;
      let o = resource.data;
      return o.uid == request.auth.uid && !('opts' in o) && !muted()
        && d.diff(o).affectedKeys().hasOnly(['text', 'edited'])
        && d.edited == true && shortText(d.text, 1, 500);
    }
    // Реакції й голоси: кожен змінює лише власний запис.
    function reactOk() {
      let d = request.resource.data;
      let o = resource.data;
      let me_ = request.auth.uid;
      return d.diff(o).affectedKeys().hasOnly(['r', 'votes'])
        && d.get('r', {}).diff(o.get('r', {})).affectedKeys().hasOnly([me_])
        && d.get('votes', {}).diff(o.get('votes', {})).affectedKeys().hasOnly([me_])
        && (!(me_ in d.get('r', {})) || d.r[me_] in ['👍', '😂', '❤️', '🔥', '😮'])
        && (!(me_ in d.get('votes', {})) || ('opts' in o && d.votes[me_] is int
                                             && d.votes[me_] >= 0 && d.votes[me_] < o.opts.size()));
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Технічна перерва: поки вона увімкнена, працює лише адміністратор.
    function maintenance() {
      return exists(/databases/$(database)/documents/meta/maintenance)
        && get(/databases/$(database)/documents/meta/maintenance).data.on == true;
    }
    function approved() { return hasProfile() && me().status == 'approved' && !maintenance(); }
    // Клас учня; для батьків — клас дитини. Вчителі бачать усі класи.
    function myClass() { return me().role == 'parent' ? me().childClass : me().cls; }
    function canUseClass(c) {
      return isAdmin() || (approved() && (me().role == 'teacher' || myClass() == c));
    }
    function shortText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'role', 'cls', 'subject', 'child', 'childClass',
                               'contact', 'note', 'status', 'createdAt', 'reviewedAt', 'invite'])
        && shortText(d.name, 2, 60)
        && d.role in ['student', 'teacher', 'parent']
        && d.status in ['pending', 'approved', 'rejected', 'kicked']
        && (d.role != 'student' || (d.cls is int && d.cls >= 1 && d.cls <= 9))
        && (d.role != 'teacher' || shortText(d.subject, 2, 60))
        && (d.role != 'parent' || (shortText(d.child, 2, 60)
                                   && d.childClass is int && d.childClass >= 1 && d.childClass <= 9))
        && (!('contact' in d) || shortText(d.contact, 0, 80))
        && (!('note' in d) || shortText(d.note, 0, 300));
    }

    // Власника можна призначити лише один раз — поки документа ще немає.
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Додаткових адміністраторів додає власник у консолі Firebase.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || approved() || isAdmin());
      allow write: if isOwner();
    }

    // Технічна перерва: бачать усі (навіть до входу), вмикає адміністратор.
    match /meta/maintenance {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'message', 'at'])
        && request.resource.data.on is bool
        && shortText(request.resource.data.message, 0, 200)
        && request.resource.data.at == request.time;
    }

    // Молодших модераторів призначає й знімає лише власник.
    match /mods/{uid} {
      // Схвалені учасники бачать, хто модератор (значок 🛡 у профілі).
      allow read: if signedIn() && (request.auth.uid == uid || approved() || isAdmin());
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Скарги на повідомлення: подає будь-який учасник, бачать адмін і модератори.
    match /reports/{id} {
      allow read: if isStaff();
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['path', 'text', 'author', 'authorName', 'by', 'byName', 'status', 'createdAt'])
        && shortText(request.resource.data.path, 3, 200)
        && shortText(request.resource.data.text, 0, 500)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName == me().name
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'done'];
      allow delete: if isAdmin();
    }

    // Мут до певного часу (не довше тижня). Ставлять адмін і модератори.
    match /mutes/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update: if isStaff() && !protectedUser(uid)
        && request.resource.data.keys().hasOnly(['until', 'by', 'at'])
        && request.resource.data.until is timestamp
        && request.resource.data.until > request.time
        && request.resource.data.until < request.time + duration.value(8, 'd')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isStaff();
    }

    // Журнал дій адміністрації: бачить лише головний адмін, змінити не можна.
    match /log/{id} {
      allow read: if isOwner();
      allow create: if isStaff() && hasProfile()
        && request.resource.data.keys().hasOnly(['action', 'target', 'targetName', 'by', 'byName', 'at'])
        && shortText(request.resource.data.action, 1, 120)
        && shortText(request.resource.data.target, 0, 128)
        && shortText(request.resource.data.targetName, 0, 80)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName == me().name
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Профіль: аватарка-емодзі, колір імені, день народження (без року).
    match /profiles/{uid} {
      allow read: if approved() || isAdmin();
      allow write: if (approved() || isAdmin()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['emoji', 'color', 'bday', 'bio', 'frame'])
        && (!('frame' in request.resource.data) || request.resource.data.frame in ['none', 'bronze', 'silver', 'gold', 'neon', 'rainbow', 'champ'])
        && (!('bio' in request.resource.data) || shortText(request.resource.data.bio, 0, 150))
        && shortText(request.resource.data.emoji, 1, 8)
        && request.resource.data.color in ['violet', 'pink', 'cyan', 'green', 'yellow', 'orange', 'red', 'blue']
        && (!('bday' in request.resource.data) || request.resource.data.bday.matches('(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'));
    }

    // Тест дня: одна спроба на день (id = дата_користувач).
    match /quiz/{id} {
      allow read: if approved() || isAdmin();
      allow create: if (approved() || isAdmin()) && hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'cls', 'day', 'month', 'ok', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.cls is int
        && request.resource.data.ok is bool
        && request.resource.data.day.matches('20[0-9][0-9]-[01][0-9]-[0-3][0-9]')
        && request.resource.data.month == request.resource.data.day[0:7]
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Коди-запрошення: створює адміністратор; новачок витрачає один вхід разом із заявкою.
    match /invites/{code} {
      allow read: if isAdmin();
      allow create: if isAdmin() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['cls', 'max', 'uses', 'expires', 'by', 'at'])
        && request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 9
        && request.resource.data.max is int && request.resource.data.max >= 1 && request.resource.data.max <= 60
        && request.resource.data.uses == 0
        && request.resource.data.expires is timestamp
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update: if signedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.invite == code;
      allow delete: if isAdmin();
    }

    // Чат класу видно всім схваленим (як і раніше), окремий чат — лише його учасникам.
    function chatMember(key) {
      return key.matches('c[1-9]')
        || (key.matches('d.+') && request.auth.uid in key[1:key.size()].split('_'))
        || (key.matches('g[A-Za-z0-9]+')
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(key[1:key.size()])).data.members);
    }

    // Закріплене повідомлення в чаті (pins/c6 — чат 6 класу, pins/g<id> — окремий чат).
    match /pins/{key} {
      allow read: if isAdmin() || (approved() && chatMember(key));
      allow create, update: if (isAdmin() || (isStaff() && key.matches('c[1-9]')))
        && request.resource.data.keys().hasOnly(['msgId', 'text', 'name', 'by', 'at'])
        && shortText(request.resource.data.text, 0, 300)
        && shortText(request.resource.data.name, 0, 60)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (isStaff() && key.matches('c[1-9]'));
    }

    // «Друкує…»: кожен оновлює лише свій запис.
    match /typing/{key}/users/{uid} {
      allow read: if isAdmin() || (approved() && chatMember(key));
      allow create, update: if (approved() || isAdmin()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'name'])
        && request.resource.data.name == me().name
        && request.resource.data.at == request.time;
    }

    // Хто до якого моменту прочитав чат (для ✓✓).
    match /reads/{id} {
      allow read: if approved() || isAdmin();
      allow create, update: if (approved() || isAdmin())
        && request.resource.data.keys().hasOnly(['chat', 'uid', 'at'])
        && shortText(request.resource.data.chat, 2, 80)
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.chat + '_' + request.auth.uid
        && request.resource.data.at == request.time;
    }

    // Питання до тесту дня від модераторів.
    match /quizbank/{id} {
      allow read: if approved() || isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['cls', 'q', 'o', 'a', 'by', 'at'])
        && request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 9
        && shortText(request.resource.data.q, 3, 200)
        && request.resource.data.o is list && request.resource.data.o.size() >= 2 && request.resource.data.o.size() <= 4
        && request.resource.data.a is int && request.resource.data.a >= 0 && request.resource.data.a < request.resource.data.o.size()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isStaff();
    }

    // Відвідування по днях (для статистики адміністратора).
    match /visits/{id} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['day', 'uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day.matches('20[0-9][0-9]-[01][0-9]-[0-3][0-9]')
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Оновлення сайту: читають усі учасники, публікує адміністратор.
    match /updates/{id} {
      allow read: if approved() || isAdmin();
      allow create: if isAdmin() && hasProfile()
        && request.resource.data.keys().hasOnly(['ver', 'title', 'text', 'by', 'byName', 'at'])
        && shortText(request.resource.data.ver, 0, 20)
        && shortText(request.resource.data.title, 2, 100)
        && shortText(request.resource.data.text, 1, 3000)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName == me().name
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Списки класів (хто має бути на порталі). Бачать адмін і модератори, змінює адмін.
    match /roster/{cls} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['names', 'at'])
        && request.resource.data.names is list
        && request.resource.data.names.size() <= 60
        && request.resource.data.at == request.time;
    }

    // Список учасників (ім'я, роль, клас), щоб запрошувати в чати.
    // Читають схвалені учасники, пише лише адміністратор.
    match /directory/{uid} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'role', 'cls'])
        && shortText(request.resource.data.name, 2, 60)
        && (request.resource.data.cls == null
            || (request.resource.data.cls is int && request.resource.data.cls >= 1 && request.resource.data.cls <= 9));
      allow delete: if isAdmin();
    }

    // Заявки = профілі користувачів.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Нова заявка: лише від свого імені й лише зі статусом «на розгляді».
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data);

      // З дійсним кодом-запрошенням заявка схвалюється одразу (і код витрачається).
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.status == 'approved'
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data)
        && 'invite' in request.resource.data
        && request.resource.data.invite.matches('[A-Z0-9]{6}')
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.invite))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.uses
           < get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.max
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.expires > request.time
        && get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.cls
           == (request.resource.data.role == 'parent' ? request.resource.data.childClass : request.resource.data.cls)
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.uses
           == get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.uses + 1;

      // Адміністратор схвалює, відхиляє або виправляє заявку.
      allow update: if isAdmin() && validProfile(request.resource.data);

      // Користувач може виправити й подати заявку знову, поки її не схвалили.
      // Кікнутий чекає, поки його поверне адміністратор.
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.status != 'approved' && resource.data.status != 'kicked'
        && validProfile(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && !('reviewedAt' in request.resource.data);

      allow delete: if isAdmin();
    }

    // Коли людина востаннє заходила. Бачить лише адміністратор,
    // записати можна лише свій час і лише поточний.
    match /presence/{uid} {
      allow read: if isAdmin() || isMod();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
    }

    // Чат класу: classes/<номер класу>/messages/<id>
    match /classes/{cls}/messages/{msg} {
      allow read: if canUseClass(int(cls)) || isMod();
      allow create: if canUseClass(int(cls)) && hasProfile() && !muted() && validMessage(request.resource.data);
      allow update: if (canUseClass(int(cls)) || isMod()) && (reactOk() || editOk());
      allow delete: if isAdmin() || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /classes/{cls}/media/{id} {
      allow read: if canUseClass(int(cls)) || isMod();
      allow create: if canUseClass(int(cls)) && hasProfile() && !muted() && validMedia(request.resource.data);
      allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Окремі чати. Працюють лише після схвалення адміністратором;
    // нових учасників теж додає адміністратор (зі списку invited).
    match /groups/{gid} {
      allow read: if isAdmin() || isMod() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'invited', 'status', 'createdAt'])
        && shortText(request.resource.data.name, 2, 40)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.invited is list
        && request.resource.data.invited.size() >= 1 && request.resource.data.invited.size() <= 40
        && !(request.auth.uid in request.resource.data.invited)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // Адміністратор схвалює чат або запрошення.
      allow update: if isAdmin();
      // Автор чату запрошує ще людей — вони чекають схвалення адміністратора.
      allow update: if approved() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
        && request.resource.data.invited is list && request.resource.data.invited.size() <= 40;
      // Учасник може вийти з чату.
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      allow delete: if isAdmin();

      match /messages/{mid} {
        function grp() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        function inGroup() { return approved() && grp().status == 'approved' && request.auth.uid in grp().members; }
        allow read: if isAdmin() || inGroup();
        allow create: if inGroup() && !muted() && validMessage(request.resource.data);
        allow update: if inGroup() && (reactOk() || editOk());
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
      match /media/{id} {
        function grp2() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
        function inGroup2() { return approved() && grp2().status == 'approved' && request.auth.uid in grp2().members; }
        allow read: if isAdmin() || inGroup2();
        allow create: if inGroup2() && !muted() && validMedia(request.resource.data);
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Особисті повідомлення: id = uid1_uid2 (за алфавітом). Читають лише двоє.
    match /dms/{dmid} {
      allow read: if approved() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['members', 'at'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && dmid == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.members[0]))
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.members[1]))
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
      match /messages/{mid} {
        allow read: if approved() && request.auth.uid in dmid.split('_');
        allow create: if approved() && request.auth.uid in dmid.split('_') && !muted() && validMessage(request.resource.data);
        allow update: if approved() && request.auth.uid in dmid.split('_') && (reactOk() || editOk());
        // Модератори можуть видалити повідомлення за скаргою, але читати чужі особисті не можуть.
        allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      }
      match /media/{id} {
        allow read: if approved() && request.auth.uid in dmid.split('_');
        allow create: if approved() && request.auth.uid in dmid.split('_') && !muted() && validMedia(request.resource.data);
        allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Історії (як в Instagram): фото чи відео до 15 с, зникають через 24 год.
    // Файл ділиться на частини (stories/{id}/parts/0, 1, …), бо документ не може бути більшим за 1 МБ.
    match /stories/{sid} {
      allow read: if approved() || isAdmin();
      allow create: if (approved() || isAdmin()) && hasProfile() && !muted()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'mime', 'parts', 'dur', 'caption', 'cls', 'seen', 'likes', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.kind in ['img', 'video']
        && shortText(request.resource.data.mime, 5, 60)
        && (request.resource.data.mime.matches('image/.*') || request.resource.data.mime.matches('video/.*'))
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 5
        && request.resource.data.dur is number && request.resource.data.dur >= 0 && request.resource.data.dur <= 16
        && (!('caption' in request.resource.data) || shortText(request.resource.data.caption, 0, 120))
        && request.resource.data.cls is int
        && request.resource.data.seen == {} && request.resource.data.likes == {}
        && request.resource.data.at == request.time;
      // Переглядачі ставлять лише свою позначку «бачив» і свій лайк.
      allow update: if (approved() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'likes'])
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.seen) || request.resource.data.seen[request.auth.uid] == true)
        && (!(request.auth.uid in request.resource.data.likes) || request.resource.data.likes[request.auth.uid] == true);
      allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      match /parts/{n} {
        allow read: if approved() || isAdmin();
        allow create: if (approved() || isAdmin())
          && request.resource.data.keys().hasOnly(['uid', 'data'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.data is string && request.resource.data.data.size() <= 700000
          && getAfter(/databases/$(database)/documents/stories/$(sid)).data.uid == request.auth.uid;
        allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Віртуальний дім: кімната з обоями, підлогою й предметами. Прикрашає лише власник.
    function houseSurface(m) {
      return m is map && m.keys().hasOnly(['k', 'v', 'rep'])
        && m.k in ['p', 'up', 'url'] && shortText(m.v, 1, 500)
        && (m.k != 'url' || m.v.matches('https://[-A-Za-z0-9._~:/?#@!$&*+,;=%]+'))
        && (!('rep' in m) || m.rep is bool);
    }
    // Кімнати (до 6), вихованець, рідкісні речі й колесо удачі.
    function houseExtra(d) {
      return (!('rooms' in d) || (d.rooms is list && d.rooms.size() <= 6))
        && (!('pet' in d) || (d.pet is map && d.pet.keys().hasOnly(['e', 'r', 'name', 'xp', 'born', 'fed', 'played', 'washed', 'warm', 'slept', 'hat'])
                              && d.pet.r in ['c', 'r', 'l'] && shortText(d.pet.name, 0, 20) && d.pet.xp is int))
        && (!('inv' in d) || (d.inv is map && d.inv.keys().hasOnly(['items', 'walls', 'treats'])
                              && d.inv.items is list && d.inv.items.size() <= 50
                              && d.inv.walls is list && d.inv.walls.size() <= 20 && d.inv.treats is int))
        && (!('wheel' in d) || shortText(d.wheel, 0, 10));
    }
    match /houses/{uid} {
      allow read: if approved() || isAdmin();
      allow create: if (approved() || isAdmin()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'wall', 'floor', 'items', 'rooms', 'pet', 'inv', 'wheel', 'likes', 'at'])
        && houseExtra(request.resource.data)
        && shortText(request.resource.data.name, 1, 40)
        && houseSurface(request.resource.data.wall) && houseSurface(request.resource.data.floor)
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.likes == {}
        && request.resource.data.at == request.time;
      allow update: if (approved() || isAdmin()) && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'wall', 'floor', 'items', 'rooms', 'pet', 'inv', 'wheel', 'at'])
        && houseExtra(request.resource.data)
        && shortText(request.resource.data.name, 1, 40)
        && houseSurface(request.resource.data.wall) && houseSurface(request.resource.data.floor)
        && request.resource.data.items is list && request.resource.data.items.size() <= 60
        && request.resource.data.at == request.time;
      // Гості ставлять лише свій лайк.
      allow update: if (approved() || isAdmin()) && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.likes) || request.resource.data.likes[request.auth.uid] == true);
      allow delete: if isStaff() || (signedIn() && request.auth.uid == uid);
      // Свої картинки (стиснені), до ~150 КБ кожна.
      match /imgs/{id} {
        allow read: if approved() || isAdmin();
        allow create: if (approved() || isAdmin()) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['data', 'at'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 200000
          && request.resource.data.data[0:11] == 'data:image/'
          && request.resource.data.at == request.time;
        allow delete: if isStaff() || (signedIn() && request.auth.uid == uid);
      }
    }

    // Хрестики-нулики: двоє гравців, ходять по черзі.
    match /games/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if approved()
        && request.resource.data.keys().hasOnly(['x', 'o', 'players', 'names', 'board', 'turn', 'status', 'winner', 'at'])
        && request.resource.data.x == request.auth.uid
        && request.resource.data.o is string && request.resource.data.o != request.auth.uid
        && exists(/databases/$(database)/documents/directory/$(request.resource.data.o))
        && request.resource.data.players == [request.resource.data.x, request.resource.data.o]
        && request.resource.data.names is map
        && request.resource.data.board == '.........' && request.resource.data.turn == 'x'
        && request.resource.data.status == 'invited' && request.resource.data.winner == ''
        && request.resource.data.at == request.time;
      allow update: if approved() && request.auth.uid in resource.data.players
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board', 'turn', 'status', 'winner', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.board is string && request.resource.data.board.size() == 9
        && ((resource.data.status == 'invited' && request.auth.uid == resource.data.o
             && request.resource.data.status in ['playing', 'done'] && request.resource.data.board == resource.data.board)
            || (resource.data.status == 'playing' && request.resource.data.status in ['playing', 'done']
                && request.resource.data.turn != resource.data.turn
                && ((resource.data.turn == 'x' && request.auth.uid == resource.data.x)
                    || (resource.data.turn == 'o' && request.auth.uid == resource.data.o)))
            || (resource.data.status == 'playing' && request.resource.data.status == 'done'
                && request.resource.data.board == resource.data.board));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid in resource.data.players);
    }

    // Дошка для малювання класу: кожна лінія — окремий документ.
    match /boards/{cls}/strokes/{id} {
      allow read: if canUseClass(int(cls)) || isMod();
      allow create: if canUseClass(int(cls)) && hasProfile() && !muted()
        && request.resource.data.keys().hasOnly(['uid', 'color', 'w', 'pts', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.color is string && request.resource.data.color.matches('#[0-9A-Fa-f]{6}')
        && request.resource.data.w is int && request.resource.data.w >= 1 && request.resource.data.w <= 40
        && request.resource.data.pts is list && request.resource.data.pts.size() >= 2 && request.resource.data.pts.size() <= 800
        && request.resource.data.at == request.time;
      allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Особисті нотатки: бачить лише автор.
    match /notes/{uid}/items/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['text', 'at'])
        && shortText(request.resource.data.text, 1, 1000)
        && request.resource.data.at == request.time;
    }

    // Голосування для всієї школи: створюють адмін і модератори, голосує кожен один раз (можна змінити).
    match /spolls/{id} {
      allow read: if approved() || isAdmin();
      allow create: if isStaff() && hasProfile()
        && request.resource.data.keys().hasOnly(['q', 'opts', 'votes', 'by', 'name', 'closed', 'at'])
        && shortText(request.resource.data.q, 2, 200)
        && request.resource.data.opts is list && request.resource.data.opts.size() >= 2 && request.resource.data.opts.size() <= 6
        && request.resource.data.votes == {} && request.resource.data.closed == false
        && request.resource.data.by == request.auth.uid && request.resource.data.name == me().name
        && request.resource.data.at == request.time;
      allow update: if (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed']))
        || ((approved() || isAdmin()) && resource.data.closed == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.votes)
                || (request.resource.data.votes[request.auth.uid] is int
                    && request.resource.data.votes[request.auth.uid] >= 0
                    && request.resource.data.votes[request.auth.uid] < resource.data.opts.size())));
      allow delete: if isStaff();
    }

    // Вікно з оголошенням, яке всі побачать при вході.
    match /meta/popup {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'title', 'text', 'id', 'at'])
        && request.resource.data.on is bool
        && shortText(request.resource.data.title, 0, 80) && shortText(request.resource.data.text, 0, 600)
        && shortText(request.resource.data.id, 1, 40)
        && request.resource.data.at == request.time;
    }
    // Налаштування порталу: скільки днів зберігати повідомлення (0 — завжди).
    match /meta/settings {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['retention', 'at'])
        && request.resource.data.retention in [0, 30, 90, 180, 365]
        && request.resource.data.at == request.time;
    }

    // Бібліотека: посилання на книги. Додають адміністратор і модератори.
    match /books/{id} {
      allow read: if isAdmin() || approved();
      allow create: if (isAdmin() || isMod()) && hasProfile()
        && request.resource.data.keys().hasOnly(['title', 'author', 'subject', 'cls', 'url', 'uid', 'name', 'createdAt'])
        && shortText(request.resource.data.title, 2, 120)
        && (!('author' in request.resource.data) || shortText(request.resource.data.author, 0, 80))
        && shortText(request.resource.data.subject, 2, 40)
        && request.resource.data.cls is int && request.resource.data.cls >= 0 && request.resource.data.cls <= 9
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && request.resource.data.url.matches('https://[^ ]+')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || isMod();
    }

    // Оголошення: cls = 0 — для всієї школи, 1–9 — для класу.
    match /announcements/{id} {
      allow read: if isAdmin() || approved();
      allow create: if (isAdmin() || approved()) && hasProfile() && !muted()
        && request.resource.data.keys().hasOnly(['cls', 'title', 'text', 'uid', 'name', 'role', 'createdAt', 'showAt'])
        && (!('showAt' in request.resource.data)
            || ((isStaff() || me().role == 'teacher') && request.resource.data.showAt is timestamp
                && request.resource.data.showAt > request.time
                && request.resource.data.showAt < request.time + duration.value(31, 'd')))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.role == me().role
        && request.resource.data.cls is int
        && request.resource.data.cls >= 0 && request.resource.data.cls <= 9
        && (isAdmin() || me().role == 'teacher' || request.resource.data.cls == myClass())
        && shortText(request.resource.data.title, 2, 80)
        && shortText(request.resource.data.text, 1, 1000)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || isMod() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
